---
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Page not found" noindex>
  <main id="main" tabindex="-1" class="wrap notfound">
    <p class="sec-num">404</p>
    <h1 class="hero-title">Page not <em>found.</em></h1>
    <p class="hero-sub">The page you're looking for doesn't exist.</p>
    <p class="hero-cta"><a class="btn btn-ink" href="/">Go to the home page</a></p>
  </main>
</Layout>
