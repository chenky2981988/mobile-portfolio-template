---
interface Props { id: string; num: string; label: string; title: string; lede?: string; class?: string }
const { id, num, label, title, lede, class: cls = "" } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-h`} class={`sec ${cls}`} data-fade>
  <div class="wrap">
    <header class="sec-head">
      <p class="sec-num"><span aria-hidden="true">{num} /</span> {label}</p>
      <div>
        <h2 id={`${id}-h`} class="sec-title">{title}</h2>
        {lede && <p class="sec-lede">{lede}</p>}
      </div>
    </header>
    <slot />
  </div>
</section>
